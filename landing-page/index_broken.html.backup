<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>
            uroboro - Development work capture with timeline visualization
        </title>
        <meta
            name="description"
            content="Capture your development work automatically and see it as a beautiful timeline. Turn insights into shareable content. Three commands. Local-first."
        />
        <meta
            name="keywords"
            content="developer tools, timeline visualization, development capture, programming workflow"
        />
        <meta name="author" content="uroboro" />

        <!-- Accessibility Meta -->
        <meta name="theme-color" content="#2a1f3d" />
        <meta name="color-scheme" content="dark" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="uroboro - Development work capture + timeline visualization"
        />
        <meta
            property="og:description"
            content="Automatic development work capture with beautiful timeline visualization. See your coding journey as a story."
        />
        <meta property="og:url" content="https://uroboro.dev" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="stylesheet" href="style.css" />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />
        <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    </head>
