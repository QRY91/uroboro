                uroboro uroboro uroboro uroboro uroboro

                <!-- Problem Section -->
                <section class="section">
                    <div class="container">
                        <h2>The Problem</h2>
                        <p
                            style="
                                text-align: center;
                                font-size: 1.2rem;
                                max-width: 800px;
                                margin: 0 auto;
                            "
                        >
                            You solve complex problems, make smart decisions,
                            and build valuable features.<br />
                            <strong
                                >But there's no record of the thinking behind
                                it.</strong
                            ><br />
                            Your amazing work goes unnoticed.
                        </p>
                    </div>
                </section>

                <!-- Solution Section -->
                <section class="section demo" id="demo">
                    <div class="container">
                        <h2>The Solution: 3 Commands</h2>

                        <div class="workflow">
                            <div class="step">
                                <div class="step-number">1</div>
                                <h3>Capture</h3>
                                <div class="code">
                                    $ uroboro capture "Fixed database timeout -
                                    cut query time from 3s to 200ms"
                                </div>
                                <p>
                                    Capture insights as you work. Takes 10
                                    seconds.
                                </p>
                            </div>

                            <div class="step">
                                <div class="step-number">2</div>
                                <h3>Visualize</h3>
                                <div class="code">
                                    $ uroboro publish --journey
                                </div>
                                <p>
                                    See your work as an interactive timeline at
                                    <code>localhost:8080</code>
                                </p>
                            </div>

                            <div class="step">
                                <div class="step-number">3</div>
                                <h3>Share</h3>
                                <div class="code">$ uroboro publish --blog</div>
                                <p>
                                    Generate shareable content from your actual
                                    work.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Timeline Preview -->
                <section class="section">
                    <div class="container">
                        <h2>Your Development Story</h2>
                        <p style="text-align: center; margin-bottom: 40px">
                            This is what makes uroboro different - timeline
                            visualization of your actual work:
                        </p>

                        <div class="timeline-preview">
                            <div class="timeline-item">
                                <div class="timeline-content">
                                    <div class="timeline-time">
                                        Today, 2:30 PM
                                    </div>
                                    <div class="timeline-text">
                                        Fixed database timeout - cut query time
                                        from 3s to 200ms
                                    </div>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-content">
                                    <div class="timeline-time">
                                        Today, 11:15 AM
                                    </div>
                                    <div class="timeline-text">
                                        Implemented user authentication with JWT
                                        tokens
                                    </div>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-content">
                                    <div class="timeline-time">
                                        Yesterday, 4:45 PM
                                    </div>
                                    <div class="timeline-text">
                                        Refactored API endpoints for better
                                        performance
                                    </div>
                                </div>
                            </div>
                        </div>

                        <p
                            style="
                                text-align: center;
                                font-style: italic;
                                margin-top: 30px;
                            "
                        >
                            "Version control for your head" - see patterns,
                            track progress, share insights.
                        </p>
                    </div>
                </section>

                <!-- Features -->
                <section class="section" style="background: white">
                    <div class="container">
                        <div class="features">
                            <div class="feature">
                                <span class="feature-icon">🎯</span>
                                <h3>Smart Detection</h3>
                                <p>
                                    Auto-detects projects from git repos. Zero
                                    configuration.
                                </p>
                            </div>
                            <div class="feature">
                                <span class="feature-icon">🏷️</span>
                                <h3>Auto-Tagging</h3>
                                <p>
                                    Recognizes features, bugfixes, and technical
                                    decisions automatically.
                                </p>
                            </div>
                            <div class="feature">
                                <span class="feature-icon">🔒</span>
                                <h3>Local-First</h3>
                                <p>
                                    Your data stays on your machine. No cloud,
                                    no tracking.
                                </p>
                            </div>
                            <div class="feature">
                                <span class="feature-icon">⚡</span>
                                <h3>Zero Friction</h3>
                                <p>
                                    Designed for busy developers. Capture in
                                    seconds, not minutes.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- What This Isn't -->
                <section class="section" style="background: #f7fafc">
                    <div class="container">
                        <h2>What This Isn't</h2>
                        <div
                            style="
                                max-width: 600px;
                                margin: 0 auto;
                                text-align: center;
                            "
                        >
                            <p>
                                <strong>❌ Not a productivity dashboard</strong
                                ><br />
                                <strong>❌ Not an AI assistant</strong><br />
                                <strong
                                    >❌ Not a team collaboration tool</strong
                                >
                            </p>

                            <p style="margin-top: 30px; font-size: 1.1rem">
                                <strong
                                    >✅ A tool that documents your actual
                                    work</strong
                                ><br />
                                <strong
                                    >✅ Timeline visualization for your
                                    development journey</strong
                                ><br />
                                <strong
                                    >✅ A way to get acknowledged for what you
                                    build</strong
                                >
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Install -->
                <section class="section cta">
                    <div class="container">
                        <h2>Get Started</h2>
                        <div
                            class="code"
                            style="max-width: 600px; margin: 20px auto"
                        >
                            go install
                            github.com/QRY91/uroboro/cmd/uroboro@latest uroboro
                            capture "Your first development insight" uroboro
                            publish --journey
                        </div>
                        <p style="margin-top: 30px">
                            <a
                                href="https://github.com/QRY91/uroboro"
                                class="btn btn-secondary"
                                >View Documentation</a
                            >
                        </p>
                    </div>
                </section>

                <!-- Footer -->
                <footer class="footer">
                    <div class="container">
                        <p>
                            Built by a developer, for developers. No enterprise
                            BS, just a useful tool that works.
                        </p>
                        <p style="margin-top: 10px; opacity: 0.7">
                            "The only tool that turns your actual development
                            work into professional content"
                        </p>
                    </div>
                </footer>

